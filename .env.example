# ── Beheer & beveiliging ──────────────────────────────────────────────────────
# Kopieer dit bestand naar .env en vul de juiste waarden in.
# Het .env-bestand staat in .gitignore en wordt nooit gecommit.

# Beheerderswachtwoord voor het admin-dashboard en de team-API.
# Gebruik een lang, willekeurig wachtwoord in productie.
ADMIN_TOKEN=vervang-mij-door-een-sterk-wachtwoord

# Geheime sleutel voor het ondertekenen van sessie-cookies.
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=vervang-mij-door-een-willekeurige-string

# Poort waarop de server draait (standaard: 3000)
PORT=3000

# ── SMTP-instellingen ─────────────────────────────────────────────────────────

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@decoachtrain.nl
SMTP_PASS=jouw-smtp-wachtwoord

# ── E-mailadressen ────────────────────────────────────────────────────────────
# Afzender (From-header)
MAIL_FROM=De Coachtrain <info@decoachtrain.nl>

# Ontvanger van de beheerder-notificatie (jouw eigen adres)
ADMIN_EMAIL=andrewvanderveen@decoachtrain.nl

# ── Rapportlink in de e-mail ──────────────────────────────────────────────────
# Basis-URL van de productie-omgeving (zonder trailing slash).
# Wordt gebruikt voor de "Bekijk rapport online"-knop in de invuller-mail.
BASE_URL=https://www.decoachtrain.nl

# ── Testmodus ─────────────────────────────────────────────────────────────────
# Zet op 'true' om e-mails NIET te versturen maar alleen in de console te loggen.
# Handig tijdens lokale ontwikkeling zonder SMTP-server.
MAIL_TEST_MODE=true
